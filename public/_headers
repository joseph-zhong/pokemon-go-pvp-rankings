# Vite content-hashes everything under /assets, so it's safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The Pokemon dataset is refreshed daily by .github/workflows/update-data.yml
# and isn't content-hashed, so give it a short cache instead.
/data/pokemon.min.json
  Cache-Control: public, max-age=3600, must-revalidate
