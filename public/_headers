# Vite content-hashes everything under /assets, so it's safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These are all refreshed daily by .github/workflows/update-data.yml and
# aren't content-hashed, so give them a short cache instead.
/data/pokemon.min.json
  Cache-Control: public, max-age=3600, must-revalidate
/data/moves.min.json
  Cache-Control: public, max-age=3600, must-revalidate
/data/movesets.min.json
  Cache-Control: public, max-age=3600, must-revalidate
